import {
  useCallback,
  useEffect,
  useRef,
  useState,
} from 'react'

import { useLiveQuery } from 'dexie-react-hooks'

import {
  BookOpen,
  Globe,
  LockKeyhole,
  Plus,
  Trash2,
  Users,
} from 'lucide-react'

import {
  getActiveDatabase,
  isActiveDatabase,
} from '../../db/database'

import type { Account } from '../account/accountApi'

import { API_URL } from '../account/accountApi'

interface NotesPageProps {
  account: Account | null
}

interface CommunityNote {
  id: string
  book_title: string
  content: string
  nickname: string
  username: string
  created_at: string
  updated_at: string
  is_published: boolean
  is_owner: boolean
}

interface ApiError {
  detail?: string | { message?: string }
}

interface ChapterOption {
  title: string
  pageNumber: number | null
  depth: number
}

async function getErrorMessage(
  response: Response,
): Promise<string> {
  try {
    const result = (await response.json()) as ApiError

    if (typeof result.detail === 'string') {
      return result.detail
    }

    if (
      result.detail &&
      typeof result.detail.message === 'string'
    ) {
      return result.detail.message
    }
  } catch {
    // Ignore responses that are not JSON.
  }

  return `The request failed (${response.status}).`
}

/**
 * Detect chapter headings in extracted PDF text.
 */
function detectChaptersFromPages(
  pages: Array<{
    pageNumber: number
    text: string
  }>,
): ChapterOption[] {
  const found: ChapterOption[] = []
  const seen = new Set<string>()

  const chapterPattern =
    /\bchapter\s+(\d{1,3}|[ivxlcdm]{1,8}|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|hundred)\b/gi

  for (const page of [...pages].sort(
    (a, b) => a.pageNumber - b.pageNumber,
  )) {
    const text = page.text.replace(/\s+/g, ' ')

    chapterPattern.lastIndex = 0

    let match: RegExpExecArray | null

    while ((match = chapterPattern.exec(text)) !== null) {
      const numberOrWord = match[1]
      const title = `Chapter ${numberOrWord}`
      const key = title.toLocaleLowerCase()

      if (!seen.has(key)) {
        seen.add(key)

        found.push({
          title,
          pageNumber: page.pageNumber,
          depth: 0,
        })
      }

      if (chapterPattern.lastIndex === match.index) {
        chapterPattern.lastIndex++
      }
    }
  }

  return found
}

export function NotesPage({
  account,
}: NotesPageProps) {
  // Capture the database belonging to the mounted account.
  const db = getActiveDatabase()

  const mountedRef = useRef(true)

  const communityRequestRef = useRef(0)

  const [isCreating, setIsCreating] = useState(false)

  const [selectedBookId, setSelectedBookId] = useState('')
  const [selectedChapterIndex, setSelectedChapterIndex] =
    useState('')

  const [manualChapterTitle, setManualChapterTitle] =
    useState('')

  const [manualChapterPage, setManualChapterPage] =
    useState('1')

  const [content, setContent] = useState('')

  const [communityNotes, setCommunityNotes] = useState<
    CommunityNote[]
  >([])

  const [communityLoading, setCommunityLoading] =
    useState(false)

  const [saving, setSaving] = useState(false)

  const [error, setError] = useState('')
  const [message, setMessage] = useState('')

  useEffect(() => {
    mountedRef.current = true

    return () => {
      mountedRef.current = false
      communityRequestRef.current++
    }
  }, [])

  /*
   * All private queries use the captured account database.
   */
  const books = useLiveQuery(
    () => db.documents.orderBy('title').toArray(),
    [db],
    [],
  )

  const notes = useLiveQuery(
    () =>
      db.notes
        .orderBy('updatedAt')
        .reverse()
        .toArray(),
    [db],
    [],
  )

  const bookList = books ?? []
  const noteList = notes ?? []

  const selectedBook = bookList.find(
    (book) => book.id === selectedBookId,
  )

  /*
   * Load pages from the same database as the selected book.
   */
 const selectedBookPages =
  useLiveQuery(
    () =>
      selectedBookId
        ? db.pages
            .where('documentId')
            .equals(selectedBookId)
            .sortBy('pageNumber')
        : Promise.resolve([]),
    [db, selectedBookId],
    [],
  )

  /*
   * Prefer the stored PDF outline.
   */
  const bookmarkedChapters =
    selectedBook?.outline?.filter(
      (chapter) => chapter.pageNumber !== null,
    ) ?? []

  const detectedChapters =
    detectChaptersFromPages(selectedBookPages)

  const chapters =
    bookmarkedChapters.length > 0
      ? bookmarkedChapters
      : detectedChapters

  /*
   * Resolve the selected chapter.
   */
  const selectedChapter =
    selectedChapterIndex === 'manual'
      ? manualChapterTitle.trim()
        ? {
            title: manualChapterTitle.trim(),
            pageNumber: Math.max(
              1,
              Number.parseInt(manualChapterPage, 10) || 1,
            ),
            depth: 0,
          }
        : undefined
      : selectedChapterIndex !== ''
        ? chapters[Number(selectedChapterIndex)]
        : undefined

  /*
   * Load community notes from the backend.
   *
   * Community posts are intentionally shared between accounts.
   * They are not stored in the private IndexedDB database.
   */
  const loadCommunityNotes = useCallback(async () => {
    const operationDatabase = db
    const requestId = ++communityRequestRef.current

    if (!account) {
      if (
        mountedRef.current &&
        isActiveDatabase(operationDatabase)
      ) {
        setCommunityNotes([])
        setCommunityLoading(false)
      }

      return
    }

    if (!isActiveDatabase(operationDatabase)) {
      return
    }

    setCommunityLoading(true)

    try {
      const response = await fetch(
        `${API_URL}/publications/community`,
        {
          method: 'GET',
          credentials: 'include',
        },
      )

      if (
        !mountedRef.current ||
        !isActiveDatabase(operationDatabase) ||
        requestId !== communityRequestRef.current
      ) {
        return
      }

      if (!response.ok) {
        throw new Error(await getErrorMessage(response))
      }

      const result =
        (await response.json()) as CommunityNote[]

      if (
        !mountedRef.current ||
        !isActiveDatabase(operationDatabase) ||
        requestId !== communityRequestRef.current
      ) {
        return
      }

      setCommunityNotes(result)
      setError('')
    } catch (err) {
      if (
        mountedRef.current &&
        isActiveDatabase(operationDatabase) &&
        requestId === communityRequestRef.current
      ) {
        setError(
          err instanceof Error
            ? err.message
            : 'Could not load community notes.',
        )
      }
    } finally {
      if (
        mountedRef.current &&
        isActiveDatabase(operationDatabase) &&
        requestId === communityRequestRef.current
      ) {
        setCommunityLoading(false)
      }
    }
  }, [account, db])

  /*
   * Reset temporary form state when the account changes.
   */
  useEffect(() => {
    setIsCreating(false)
    setSelectedBookId('')
    setSelectedChapterIndex('')
    setManualChapterTitle('')
    setManualChapterPage('1')
    setContent('')
    setError('')
    setMessage('')
  }, [account?.id, db])

  /*
   * Load shared community content when the account changes.
   */
  useEffect(() => {
    void loadCommunityNotes()
  }, [loadCommunityNotes])

  /*
   * Create a private note in the captured database.
   */
  async function createNote() {
    const operationDatabase = db

    const text = content.trim()

    if (
      !selectedBookId ||
      !selectedChapter ||
      !text
    ) {
      setError(
        'Select a book, select a chapter, and write a note.',
      )
      return
    }

    if (!isActiveDatabase(operationDatabase)) {
      setError(
        'Your account session is changing. Please try again.',
      )
      return
    }

    setError('')
    setMessage('')
    setSaving(true)

    try {
      const book = await operationDatabase.documents.get(
        selectedBookId,
      )

      if (!isActiveDatabase(operationDatabase)) {
        return
      }

      if (!book) {
        setError('The selected book could not be found.')
        return
      }

      const now = new Date()

      await operationDatabase.notes.add({
        id: crypto.randomUUID(),
        documentId: book.id,
        bookTitle: book.title,
        chapterTitle: selectedChapter.title,
        chapterPageNumber: selectedChapter.pageNumber,
        content: text,
        authorName: account?.display_name ?? null,
        createdAt: now,
        updatedAt: now,
        isPublished: false,
      })

      if (!isActiveDatabase(operationDatabase)) {
        return
      }

      setContent('')
      setSelectedBookId('')
      setSelectedChapterIndex('')
      setManualChapterTitle('')
      setManualChapterPage('1')
      setIsCreating(false)

      setMessage(
        `Your note about "${selectedChapter.title}" was saved privately.`,
      )
    } catch (err) {
      if (
        mountedRef.current &&
        isActiveDatabase(operationDatabase)
      ) {
        console.error('Could not save the note:', err)
        setError('Could not save your note.')
      }
    } finally {
      if (
        mountedRef.current &&
        isActiveDatabase(operationDatabase)
      ) {
        setSaving(false)
      }
    }
  }

  /*
   * Publish a private note or make a published note private.
   */
  async function togglePublished(
    noteId: string,
    published: boolean,
  ) {
    const operationDatabase = db

    if (!isActiveDatabase(operationDatabase)) {
      return
    }

    setError('')
    setMessage('')

    if (!account) {
      setError('Please sign in before publishing a note.')
      return
    }

    if (!noteId) {
      setError('The selected note could not be found.')
      return
    }

    setSaving(true)

    try {
      const note = await operationDatabase.notes.get(noteId)

      if (!isActiveDatabase(operationDatabase)) {
        return
      }

      if (!note) {
        throw new Error('The note could not be found.')
      }

      if (published) {
        /*
         * Gather extracted PDF text for the backend
         * copyright check.
         */
        const pages = await operationDatabase.pages
          .where('documentId')
          .equals(note.documentId)
          .toArray()

        if (!isActiveDatabase(operationDatabase)) {
          return
        }

        const sourceText = pages
          .sort((a, b) => a.pageNumber - b.pageNumber)
          .map((page) => page.text.trim())
          .filter(Boolean)
          .join('\n\n')

        if (!sourceText.trim()) {
          throw new Error(
            'This book has no extracted text for copyright checking. ' +
              'Import a text-based PDF before publishing this note.',
          )
        }

        const response = await fetch(
          `${API_URL}/publications/community`,
          {
            method: 'POST',
            credentials: 'include',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              book_title: note.bookTitle,
              content: note.content,
              source_text: sourceText,
            }),
          },
        )

        if (!isActiveDatabase(operationDatabase)) {
          return
        }

        if (!response.ok) {
          throw new Error(await getErrorMessage(response))
        }

        const publishedNote =
          (await response.json()) as CommunityNote

        if (!isActiveDatabase(operationDatabase)) {
          return
        }

        await operationDatabase.notes.update(noteId, {
          isPublished: true,
          authorName: publishedNote.nickname,
          updatedAt: new Date(),
        })

        if (!isActiveDatabase(operationDatabase)) {
          return
        }

        setMessage(
          'Your note was published to the community.',
        )
      } else {
        /*
         * Find the corresponding community note owned
         * by the current user.
         */
        const communityNote = communityNotes.find(
          (item) =>
            item.is_owner &&
            item.book_title === note.bookTitle &&
            item.content === note.content,
        )

        if (!communityNote) {
          throw new Error(
            'Could not find the published community note. ' +
              'Refresh the community list and try again.',
          )
        }

        const response = await fetch(
          `${API_URL}/publications/community/${communityNote.id}`,
          {
            method: 'PATCH',
            credentials: 'include',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              is_published: false,
            }),
          },
        )

        if (!isActiveDatabase(operationDatabase)) {
          return
        }

        if (!response.ok) {
          throw new Error(await getErrorMessage(response))
        }

        await operationDatabase.notes.update(noteId, {
          isPublished: false,
          updatedAt: new Date(),
        })

        if (!isActiveDatabase(operationDatabase)) {
          return
        }

        setMessage('Your note is now private.')
      }

      await loadCommunityNotes()
    } catch (err) {
      if (
        mountedRef.current &&
        isActiveDatabase(operationDatabase)
      ) {
        console.error('Could not update the note:', err)

        setError(
          err instanceof Error
            ? err.message
            : 'Could not update the note.',
        )
      }
    } finally {
      if (
        mountedRef.current &&
        isActiveDatabase(operationDatabase)
      ) {
        setSaving(false)
      }
    }
  }

  /*
   * Delete a private note from this account's database.
   */
  async function deleteNote(noteId: string) {
    const operationDatabase = db

    if (!isActiveDatabase(operationDatabase)) {
      return
    }

    setError('')
    setMessage('')

    try {
      const note = await operationDatabase.notes.get(noteId)

      if (!isActiveDatabase(operationDatabase)) {
        return
      }

      if (!note) {
        setError('The note could not be found.')
        return
      }

      if (note.isPublished) {
        setError(
          'Make the note private before deleting it.',
        )
        return
      }

      await operationDatabase.notes.delete(noteId)

      if (!isActiveDatabase(operationDatabase)) {
        return
      }

      setMessage('Your note was deleted.')
    } catch (err) {
      if (
        mountedRef.current &&
        isActiveDatabase(operationDatabase)
      ) {
        console.error('Could not delete the note:', err)
        setError('Could not delete your note.')
      }
    }
  }

  /*
   * Delete a community note owned by the current user.
   */
  async function deleteCommunityNote(
    communityNote: CommunityNote,
  ) {
    const operationDatabase = db

    if (
      !communityNote.is_owner ||
      !isActiveDatabase(operationDatabase)
    ) {
      return
    }

    setError('')
    setMessage('')

    try {
      const response = await fetch(
        `${API_URL}/publications/community/${communityNote.id}`,
        {
          method: 'DELETE',
          credentials: 'include',
        },
      )

      if (!isActiveDatabase(operationDatabase)) {
        return
      }

      if (!response.ok) {
        throw new Error(await getErrorMessage(response))
      }

      const matchingNotes = noteList.filter(
        (note) =>
          note.isPublished &&
          note.bookTitle === communityNote.book_title &&
          note.content === communityNote.content,
      )

      for (const note of matchingNotes) {
        if (!isActiveDatabase(operationDatabase)) {
          return
        }

        await operationDatabase.notes.update(note.id, {
          isPublished: false,
          updatedAt: new Date(),
        })
      }

      if (!isActiveDatabase(operationDatabase)) {
        return
      }

      setCommunityNotes((current) =>
        current.filter(
          (note) => note.id !== communityNote.id,
        ),
      )

      setMessage('Your community note was deleted.')
    } catch (err) {
      if (
        mountedRef.current &&
        isActiveDatabase(operationDatabase)
      ) {
        console.error(
          'Could not delete the community note:',
          err,
        )

        setError(
          err instanceof Error
            ? err.message
            : 'Could not delete the community note.',
        )
      }
    }
  }

  return (
    <section className="notes-page">
      <header className="notes-page-header">
        <div>
          <p className="eyebrow">Reading memory</p>

          <h1>Your notes</h1>

          <p className="notes-description">
            Capture your thoughts and observations
            about the books you read.
          </p>
        </div>

        {!isCreating && (
          <button
            type="button"
            className="notes-new-button"
            onClick={() => {
              setError('')
              setMessage('')
              setIsCreating(true)
            }}
          >
            <Plus size={17} />
            New note
          </button>
        )}
      </header>

      {error && (
        <div
          role="alert"
          className="notes-message notes-error"
        >
          {error}
        </div>
      )}

      {message && (
        <div
          role="status"
          className="notes-message notes-success"
        >
          {message}
        </div>
      )}

      {isCreating && (
        <section className="note-editor">
          <div className="note-editor-title">
            <h2>New note</h2>

            <p>
              Write your own thoughts about a book.
            </p>
          </div>

          <div className="note-form">
            <label>
              <span>Book</span>

              <select
                value={selectedBookId}
                onChange={(event) => {
                  setSelectedBookId(event.target.value)
                  setSelectedChapterIndex('')
                  setManualChapterTitle('')
                  setManualChapterPage('1')
                  setError('')
                  setMessage('')
                }}
                required
              >
                <option value="">Select a book</option>

                {bookList.map((book) => (
                  <option
                    key={book.id}
                    value={book.id}
                  >
                    {book.title}
                  </option>
                ))}
              </select>
            </label>

            <div className="chapter-field">
              <label>
                <span>Chapter</span>

                <select
                  value={selectedChapterIndex}
                  onChange={(event) => {
                    setSelectedChapterIndex(
                      event.target.value,
                    )
                    setError('')
                    setMessage('')
                  }}
                  disabled={!selectedBookId}
                  required
                >
                  <option value="">
                    {!selectedBookId
                      ? 'Select a book first'
                      : chapters.length === 0
                        ? 'No chapter headings detected'
                        : 'Select a chapter'}
                  </option>

                  {chapters.map((chapter, index) => (
                    <option
                      key={`${chapter.title}-${index}`}
                      value={index}
                    >
                      {chapter.title} — page{' '}
                      {chapter.pageNumber ?? 'unknown'}
                    </option>
                  ))}

                  {selectedBookId && (
                    <option value="manual">
                      Enter chapter manually
                    </option>
                  )}
                </select>
              </label>

              {selectedChapterIndex === 'manual' && (
                <div className="manual-chapter-fields">
                  <label>
                    <span>Chapter title</span>

                    <input
                      type="text"
                      value={manualChapterTitle}
                      onChange={(event) =>
                        setManualChapterTitle(
                          event.target.value,
                        )
                      }
                      placeholder="e.g. Chapter 1 — Introduction"
                      required
                    />
                  </label>

                  <label>
                    <span>Starting page</span>

                    <input
                      type="number"
                      min="1"
                      max={
                        selectedBook?.pageCount ?? undefined
                      }
                      value={manualChapterPage}
                      onChange={(event) =>
                        setManualChapterPage(
                          event.target.value,
                        )
                      }
                      required
                    />
                  </label>
                </div>
              )}

              {selectedBookId &&
                chapters.length === 0 && (
                  <small>
                    The app checks PDF bookmarks and extracted
                    text for headings such as “Chapter 1”.
                    If it cannot find any, enter the chapter
                    title and its starting page manually.
                  </small>
                )}
            </div>

            <label>
              <span>Your note</span>

              <textarea
                value={content}
                onChange={(event) =>
                  setContent(event.target.value)
                }
                placeholder="What did you think about this book?"
                rows={7}
              />
            </label>
          </div>

          <div className="note-editor-footer">
            <p>
              New notes are private. You can publish them later.
            </p>

            <div>
              <button
                type="button"
                className="note-cancel"
                onClick={() => {
                  setIsCreating(false)
                  setSelectedBookId('')
                  setSelectedChapterIndex('')
                  setManualChapterTitle('')
                  setManualChapterPage('1')
                  setContent('')
                  setError('')
                  setMessage('')
                }}
              >
                Cancel
              </button>

              <button
                type="button"
                className="note-save"
                disabled={
                  saving ||
                  !selectedBookId ||
                  !selectedChapter ||
                  !content.trim()
                }
                onClick={() => void createNote()}
              >
                Save note
              </button>
            </div>
          </div>
        </section>
      )}

      {!isCreating && (
        <>
          <section className="notes-section">
            <div className="notes-section-header">
              <div>
                <p className="eyebrow">Your writing</p>

                <h2>
                  {noteList.length === 0
                    ? 'No notes yet'
                    : `${noteList.length} ${
                        noteList.length === 1
                          ? 'note'
                          : 'notes'
                      }`}
                </h2>
              </div>
            </div>

            {noteList.length === 0 ? (
              <div className="notes-empty">
                <BookOpen
                  size={24}
                  strokeWidth={1.5}
                />

                <div>
                  <h3>Start your reading memory</h3>

                  <p>
                    Write your first note about something
                    you read.
                  </p>
                </div>
              </div>
            ) : (
              <div className="notes-list">
                {noteList.map((note) => (
                  <article
                    key={note.id}
                    className="note-card"
                  >
                    <div className="note-card-book">
                      <BookOpen
                        size={17}
                        strokeWidth={1.7}
                      />

                      <span>{note.bookTitle}</span>
                    </div>

                    {note.chapterTitle && (
                      <p className="note-card-chapter">
                        <strong>Chapter:</strong>{' '}
                        {note.chapterTitle}

                        {note.chapterPageNumber != null && (
                          <>
                            {' '}
                            · Page {note.chapterPageNumber}
                          </>
                        )}
                      </p>
                    )}

                    <p className="note-card-content">
                      {note.content}
                    </p>

                    {note.authorName && (
                      <p className="note-author">
                        By {note.authorName}
                      </p>
                    )}

                    <div className="note-card-footer">
                      <span
                        className={
                          note.isPublished
                            ? 'note-status published'
                            : 'note-status private'
                        }
                      >
                        {note.isPublished ? (
                          <>
                            <Globe size={13} />
                            Published
                          </>
                        ) : (
                          <>
                            <LockKeyhole size={13} />
                            Private
                          </>
                        )}
                      </span>

                      <div className="note-actions">
                        <button
                          type="button"
                          disabled={saving || !account}
                          onClick={() =>
                            void togglePublished(
                              note.id,
                              !note.isPublished,
                            )
                          }
                        >
                          {note.isPublished
                            ? 'Make private'
                            : 'Publish'}
                        </button>

                        <button
                          type="button"
                          className="note-delete"
                          aria-label="Delete note"
                          disabled={saving}
                          onClick={() =>
                            void deleteNote(note.id)
                          }
                        >
                          <Trash2 size={15} />
                        </button>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            )}
          </section>

          <section className="notes-section">
            <div className="notes-section-header">
              <div>
                <p className="eyebrow">Shared reading</p>

                <h2>
                  <Users
                    size={19}
                    style={{
                      display: 'inline',
                      verticalAlign: 'middle',
                      marginRight: 8,
                    }}
                  />
                  Community notes
                </h2>
              </div>

              <button
                type="button"
                onClick={() =>
                  void loadCommunityNotes()
                }
                disabled={communityLoading || !account}
              >
                Refresh
              </button>
            </div>

            {!account ? (
              <p>
                Sign in to see notes shared by other readers.
              </p>
            ) : communityLoading ? (
              <p>Loading community notes...</p>
            ) : communityNotes.length === 0 ? (
              <div className="notes-empty">
                <Users
                  size={24}
                  strokeWidth={1.5}
                />

                <div>
                  <h3>No published notes yet</h3>

                  <p>
                    Publish one of your notes to start
                    the community.
                  </p>
                </div>
              </div>
            ) : (
              <div className="notes-list">
                {communityNotes.map((note) => (
                  <article
                    key={note.id}
                    className="note-card"
                  >
                    <div className="note-card-book">
                      <BookOpen size={17} />

                      <span>{note.book_title}</span>
                    </div>

                    <p className="note-author">
                      By {note.nickname} (@{note.username})
                    </p>

                    <p className="note-card-content">
                      {note.content}
                    </p>

                    <div className="note-card-footer">
                      <span className="note-status published">
                        <Globe size={13} />
                        Published
                      </span>

                      {note.is_owner && (
                        <div className="note-actions">
                          <button
                            type="button"
                            disabled={saving}
                            onClick={() => {
                              const localNote = noteList.find(
                                (item) =>
                                  item.isPublished &&
                                  item.bookTitle ===
                                    note.book_title &&
                                  item.content === note.content,
                              )

                              if (localNote) {
                                void togglePublished(
                                  localNote.id,
                                  false,
                                )
                              } else {
                                setError(
                                  'This community note does not match a local note. ' +
                                    'Refresh the page and try again.',
                                )
                              }
                            }}
                          >
                            Make private
                          </button>

                          <button
                            type="button"
                            className="note-delete"
                            aria-label="Delete community note"
                            disabled={saving}
                            onClick={() =>
                              void deleteCommunityNote(note)
                            }
                          >
                            <Trash2 size={15} />
                          </button>
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            )}
          </section>
        </>
      )}
    </section>
  )
}
/* ==========================================================
SOCIALBOOKS — LITERARY DESIGN REFINEMENT
========================================================== */

:root {
--sb-ink: #29382e;
--sb-forest: #354d40;
--sb-forest-hover: #283e33;
--sb-sage: #e9eee5;
--sb-sage-dark: #dce5d8;
--sb-paper: #fbfaf6;
--sb-white: #ffffff;
--sb-muted: #737b72;
--sb-border: #e5e3da;
--sb-radius: 10px;
--sb-shadow:
0 2px 8px rgba(41, 56, 46, 0.035),
0 12px 32px rgba(41, 56, 46, 0.025);
}

/* Overall page */

body {
background: var(--sb-paper);
color: var(--sb-ink);
-webkit-font-smoothing: antialiased;
-moz-osx-font-smoothing: grayscale;
}

.main-area {
background: var(--sb-paper);
}

.content-wrap {
width: 100%;
max-width: 1600px;
margin-inline: auto;
padding-top: 34px;
padding-bottom: 56px;
}

/* Navigation */

.sidebar {
background: #f5f5ef;
border-right-color: var(--sb-border);
}

.brand {
color: var(--sb-ink);
letter-spacing: -0.025em;
}

.brand-mark {
border-radius: 9px;
background: var(--sb-forest);
}

.nav-link {
min-height: 41px;
border-radius: 7px;
transition:
background-color 160ms ease,
color 160ms ease,
transform 160ms ease;
}

.nav-link:hover {
background: #e9ede5;
}

.nav-link.active {
color: var(--sb-forest);
background: #e3eae0;
}

.nav-link:focus-visible,
.primary-button:focus-visible,
.secondary-button:focus-visible,
.icon-button:focus-visible {
outline: 2px solid #69866c;
outline-offset: 3px;
}

/* Top navigation bar */

.topbar {
background: rgba(251, 250, 246, 0.92);
border-bottom-color: var(--sb-border);
}

/* Welcome panel */

.welcome {
min-height: 270px;
padding: 42px;
border-radius: 12px;
background-color: var(--sb-forest);
box-shadow: var(--sb-shadow);
}

.welcome h1 {
max-width: 600px;
font-size: clamp(36px, 3.4vw, 48px);
line-height: 1.12;
letter-spacing: -0.035em;
}

.welcome-description {
font-size: 14px;
line-height: 1.85;
}

.welcome-action {
margin-top: 24px;
padding-bottom: 6px;
transition: color 160ms ease;
}

/* Section headings */

.section-heading h2,
.books-list-heading h2,
.notes-section-header h2,
.memory-section-heading h2 {
color: var(--sb-ink);
letter-spacing: -0.025em;
}

.books-header h1,
.notes-page-header h1,
.memory-page-header h1,
.account-page > h1,
.placeholder-page h1 {
color: var(--sb-ink);
letter-spacing: -0.035em;
}

/* Buttons */

.primary-button {
min-height: 41px;
padding-inline: 17px;
border-color: var(--sb-forest);
border-radius: 7px;
background: var(--sb-forest);
font-weight: 600;
transition:
background-color 160ms ease,
transform 160ms ease,
box-shadow 160ms ease;
}

.primary-button:hover:not(:disabled) {
background: var(--sb-forest-hover);
box-shadow: 0 4px 12px rgba(41, 56, 46, 0.12);
}

.primary-button:active:not(:disabled) {
transform: translateY(1px);
}

/* Book list */

.book-row {
min-height: 86px;
border-bottom-color: var(--sb-border);
transition: background-color 160ms ease;
}

.book-row:hover {
background: rgba(233, 238, 229, 0.38);
}

.book-file-icon {
width: 40px;
height: 46px;
border-radius: 5px;
background: var(--sb-sage);
}

.book-link strong {
font-size: 14px;
letter-spacing: -0.01em;
}

/* Reading experience */

.reader-header {
border-bottom-color: var(--sb-border);
}

.reader-header h1 {
color: var(--sb-ink);
font-size: 23px;
}

.reader-sheet {
background: var(--sb-paper);
}

.page-text {
color: #343b34;
font-size: 17px;
line-height: 2;
}

.page-rail button {
border-radius: 6px;
transition:
background-color 140ms ease,
color 140ms ease;
}

.page-rail button:hover,
.page-rail button.selected {
color: var(--sb-forest);
background: var(--sb-sage);
}

/* AI reading companion */

.book-chat {
background: #f7f8f3;
border-top-color: var(--sb-border);
}

.chat-heading-icon,
.empty-icon {
color: var(--sb-forest);
background: var(--sb-sage);
}

.chat-message {
border: 1px solid #e9ebe4;
border-radius: 9px;
}

.chat-message.user {
border-color: var(--sb-forest);
background: var(--sb-forest);
}

.chat-form {
border-color: #dcded5;
border-radius: 9px;
transition:
border-color 160ms ease,
box-shadow 160ms ease;
}

.chat-form:focus-within {
border-color: #829781;
box-shadow: 0 0 0 3px rgba(105, 134, 108, 0.10);
}

/* Notes and commentary */

.note-editor,
.note-card,
.memory-stat-card,
.memory-book {
border-color: var(--sb-border);
border-radius: var(--sb-radius);
box-shadow: var(--sb-shadow);
}

.note-editor {
padding: 32px;
}

.note-form select,
.note-form textarea {
border-color: #deddd4;
border-radius: 8px;
transition:
border-color 160ms ease,
box-shadow 160ms ease;
}

.note-form select:focus,
.note-form textarea:focus {
border-color: #829781;
box-shadow: 0 0 0 3px rgba(105, 134, 108, 0.10);
}

.note-form textarea {
min-height: 160px;
line-height: 1.8;
}

.note-save {
border-color: var(--sb-forest);
border-radius: 7px;
background: var(--sb-forest);
transition: background-color 160ms ease;
}

.note-save:hover:not(:disabled) {
background: var(--sb-forest-hover);
}

.note-cancel {
border-radius: 7px;
}

.note-card {
transition:
border-color 160ms ease,
box-shadow 160ms ease;
}

.note-card:hover {
border-color: #d4dcd0;
box-shadow: 0 5px 18px rgba(41, 56, 46, 0.05);
}

/* Form accessibility */

input:focus-visible,
select:focus-visible,
textarea:focus-visible,
button:focus-visible,
a:focus-visible {
outline-color: #69866c;
}

/* Respect reduced-motion preferences */

@media (prefers-reduced-motion: reduce) {
*,
*::before,
*::after {
animation-duration: 0.01ms !important;
animation-iteration-count: 1 !important;
scroll-behavior: auto !important;
transition-duration: 0.01ms !important;
}
}

/* Mobile refinements */

@media (max-width: 760px) {
.content-wrap {
padding: 22px 16px 36px;
}

.welcome {
min-height: 240px;
padding: 28px 22px;
border-radius: 10px;
}

.welcome h1 {
font-size: 35px;
}

.note-editor {
padding: 21px 17px;
}

.note-card {
padding: 18px;
}

.page-text {
font-size: 16px;
line-height: 1.9;
}
}
